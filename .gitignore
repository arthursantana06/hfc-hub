# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# reference material with real client data — keep local, never commit
/past

# typescript
*.tsbuildinfo
next-env.d.ts

# Cache local da CLI do Supabase
supabase/.temp/

# Dados reais de cliente derivados de /past. O repositório é PÚBLICO — estes
# arquivos publicariam renda, dívidas e patrimônio de uma pessoa identificável.
# Ficam locais; a cobertura de testes versionada usa o cliente fictício
# `__fixtures__/exemplo.json`.
#
# `gerar-paridade.ts` entra aqui não por conter dado, mas por IMPORTAR o
# fixture: versionado, ele quebrava o build num clone limpo — que foi
# exatamente o que aconteceu no primeiro deploy.
/src/lib/planning/__fixtures__/referencia.json
/src/lib/planning/__fixtures__/referencia.ts
/src/lib/planning/parity.test.ts
/scripts/seed_referencia.sql
/scripts/seed_referencia.py
/scripts/gerar-paridade.ts
/docs/paridade-referencia.md
__pycache__/
