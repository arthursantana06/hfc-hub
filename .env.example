# HFC Hub — variáveis de ambiente (copie para .env.local e preencha)
# .env.local é ignorado pelo git; este arquivo é só o modelo.

# Supabase (Project Settings → API). São as duas únicas obrigatórias hoje.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — ignora a RLS por completo, é a chave "root" do projeto.
# SOMENTE no servidor, nunca exposta ao cliente. O app NÃO usa hoje: o cadastro é
# por convite e a RLS resolve tudo. Preencha só quando aparecer uma operação que
# precise agir fora das permissões de um usuário (apagar usuário, gerar link de
# recuperação, scripts administrativos).
SUPABASE_SERVICE_ROLE_KEY=
