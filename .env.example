# HFC Hub — variáveis de ambiente (copie para .env.local e preencha)
# .env.local é ignorado pelo git; este arquivo é só o modelo.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role — SOMENTE no servidor, nunca exposta ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Organização padrão da HFC (uuid criado pelo seed 0003_seed.sql).
# Usada no signup para vincular novos usuários ao tenant enquanto for single-tenant.
NEXT_PUBLIC_DEFAULT_ORG_ID=
